<?php
// 1. Server-seitige Sprach- und IP-Erkennung
$supported_languages = ['de', 'fr', 'en', 'it', 'pt', 'es', 'tr', 'sq', 'ar', 'zh'];
$lang = 'de'; // Standardsprache

if (isset($_GET['lang']) && in_array($_GET['lang'], $supported_languages)) {
    $lang = $_GET['lang'];
    setcookie('fasqoo_language', $lang, time() + (86400 * 30), "/");
} elseif (isset($_COOKIE['fasqoo_language']) && in_array($_COOKIE['fasqoo_language'], $supported_languages)) {
    $lang = $_COOKIE['fasqoo_language'];
} else {
    // Server-seitige IP-Geolokalisierung (Beispiel über Cloudflare-Header oder Standard-Server-Variablen)
    if (isset($_SERVER['HTTP_CF_IPCOUNTRY'])) {
        $country = strtolower($_SERVER['HTTP_CF_IPCOUNTRY']);
        if (in_array($country, ['us', 'gb', 'ca', 'au'])) { $lang = 'en'; }
        elseif ($country == 'al' || $country == 'xk') { $lang = 'sq'; }
        elseif ($country == 'fr') { $lang = 'fr'; }
        elseif ($country == 'it') { $lang = 'it'; }
        elseif ($country == 'es') { $lang = 'es'; }
        elseif ($country == 'tr') { $lang = 'tr'; }
    }
}

$dir = ($lang === 'ar') ? 'rtl' : 'ltr';
?>
