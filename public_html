    for(let i=0; i<CONFIG.DIAGNOSTIC_REQUESTS; i++){
        const url = TARGET_URL + "?fasqoo_diag=" + Date.now() + "_" + i;
        measurements.push(await timedFetch(url));
        await sleep(180);
    }

    analyzeMeasurements(measurements);
    updateNetworkProfile();
    generateReport();

    button.disabled = false;
    button.textContent = t.runCheck;
}

function analyzeMeasurements(results){
    const t = translations[currentLanguage] || translations.de;
    const successful = results.filter(r => r.ok);
    const failed = results.filter(r => !r.ok);
    const times = successful.map(r => r.ms).filter(x => Number.isFinite(x));

    const latency = times.length ? Math.round(times.reduce((a,b)=>a+b,0)/times.length) : null;

    let jitter = null;
    if(times.length >= 2){
        let diffs = [];
        for(let i=1;i<times.length;i++){ diffs.push(Math.abs(times[i]-times[i-1])); }
        jitter = Math.round(diffs.reduce((a,b)=>a+b,0)/diffs.length);
    }

    const failureRate = Math.round((failed.length/results.length)*100);
    const latest = results[results.length-1];

    latestDiagnostics.latency = latency;
    latestDiagnostics.jitter = jitter;
    latestDiagnostics.failureRate = failureRate;
    latestDiagnostics.httpStatus = latest ? latest.status : null;
    latestDiagnostics.success = successful.length > 0;

    document.getElementById("latencyValue").textContent = latency === null ? "—" : latency;
    document.getElementById("jitterValue").textContent = jitter === null ? "—" : jitter;
    document.getElementById("failureValue").textContent = failureRate;
    document.getElementById("httpValue").textContent = (latest && latest.status) ? "HTTP " + latest.status : t.badgeFailed;

    setMetricBadge("latencyBadge", latency === null ? "error" : latency <= 80 ? "good" : latency <= 150 ? "warning" : "error", latency === null ? "—" : latency <= 80 ? t.badgeGood : latency <= 150 ? t.badgeElevated : t.badgeHigh);
    setMetricBadge("jitterBadge", jitter === null ? "error" : jitter <= 15 ? "good" : jitter <= 30 ? "warning" : "error", jitter === null ? "—" : jitter <= 15 ? t.badgeStable : jitter <= 30 ? t.badgeFluctuating : t.badgeHigh);
    setMetricBadge("failureBadge", failureRate === 0 ? "good" : failureRate <= 10 ? "warning" : "error", failureRate === 0 ? "0%" : failureRate + "%");
    setMetricBadge("httpBadge", (latest && latest.ok) ? "good" : "error", (latest && latest.ok) ? t.badgeOK : t.badgeFailed);

    updateHealthScore();
    renderProblems();
    updateTestResults(results);
}

function updateHealthScore(){
    const t = translations[currentLanguage] || translations.de;
    const d = latestDiagnostics;
    let score = 100;

    if(d.latency !== null){
        if(d.latency > 300) score -= 40;
        else if(d.latency > 150) score -= 25;
        else if(d.latency > 80) score -= 10;
    }
    if(d.jitter !== null){
        if(d.jitter > 50) score -= 25;
        else if(d.jitter > 30) score -= 15;
    }
    if(d.failureRate !== null){
        if(d.failureRate > 25) score -= 30;
        else if(d.failureRate > 10) score -= 18;
    }
    if(!navigator.onLine) score -= 50;
    if(location.protocol !== "https:") score -= 10;

    score = Math.max(0, Math.min(100, score));
    latestDiagnostics.score = score;

    document.getElementById("healthScore").textContent = score;
    document.getElementById("scoreFill").style.width = score + "%";

    let title, description;
    if(score >= 90){ title = t.scoreExcellent; description = t.scoreExcellentDesc; }
    else if(score >= 75){ title = t.scoreGood; description = t.scoreGoodDesc; }
    else if(score >= 50){ title = t.scoreWarning; description = t.scoreWarningDesc; }
    else{ title = t.scoreBad; description = t.scoreBadDesc; }

    document.getElementById("healthTitleDynamic").textContent = title;
    document.getElementById("healthDescriptionDynamic").textContent = description;
}

function renderProblems(){
    const t = translations[currentLanguage] || translations.de;
    const d = latestDiagnostics;
    const problems = [];

    if(!navigator.onLine){
        problems.push({ title: t.probOfflineTitle, type: "error", evidence: t.probOfflineEv, meaning: t.probOfflineMeaning });
    }
    if(d.latency !== null && d.latency > 150){
        problems.push({ title: t.probLatencyTitle, type: d.latency > 300 ? "error" : "warning", evidence: d.latency + " ms", meaning: t.probLatencyMeaning });
    }
    if(d.jitter !== null && d.jitter > 30){
        problems.push({ title: t.probJitterTitle, type: d.jitter > 50 ? "error" : "warning", evidence: d.jitter + " ms", meaning: t.probJitterMeaning });
    }
    if(d.failureRate !== null && d.failureRate > 10){
        problems.push({ title: t.probFailureTitle, type: d.failureRate > 25 ? "error" : "warning", evidence: d.failureRate + "%", meaning: t.probFailureMeaning });
    }
    if(location.protocol !== "https:"){
        problems.push({ title: t.probHttpsTitle, type: "error", evidence: t.probHttpsEv, meaning: t.probHttpsMeaning });
    }
    if(!problems.length){
        problems.push({ title: t.probNoneTitle, type: "good", evidence: t.probNoneEv, meaning: t.probNoneMeaning });
    }

    const container = document.getElementById("problemList");
    container.innerHTML = "";

    problems.forEach(problem => {
        const wrapper = document.createElement("div");
        wrapper.className = "card problem " + problem.type;
        wrapper.innerHTML = `
            <details ${problem.type === "error" ? "open" : ""}>
                <summary>
                    <div class="problem-heading">
                        <div class="problem-icon">${problem.type === "good" ? "✓" : "!"}</div>
                        <div>
                            <div class="problem-name">${escapeHTML(problem.title)}</div>
                            <div class="problem-severity">${escapeHTML(problem.evidence)}</div>
                        </div>
                    </div>
                    <span class="badge ${problem.type === "good" ? "good" : problem.type === "error" ? "error" : "warning"}">
                        ${problem.type === "good" ? "OK" : "!"}
                    </span>
                </summary>
                <div class="problem-body">
                    <div class="explanation-grid">
                        <div class="explanation">
                            <h4>Info</h4>
                            <p>${escapeHTML(problem.meaning)}</p>
                        </div>
                    </div>
                </div>
            </details>
        `;
        container.appendChild(wrapper);
    });
}

function updateNetworkProfile(){
    const t = translations[currentLanguage] || translations.de;
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;

    document.getElementById("connectionType").textContent = (connection && connection.type) ? connection.type : t.notAvailable;
    document.getElementById("effectiveTypeValue").textContent = (connection && connection.effectiveType) ? connection.effectiveType : t.notAvailable;
    document.getElementById("downlinkValue").textContent = (connection && Number.isFinite(connection.downlink)) ? connection.downlink + " Mbps" : t.notAvailable;
    document.getElementById("browserRtt").textContent = (connection && Number.isFinite(connection.rtt)) ? connection.rtt + " ms" : t.notAvailable;
    document.getElementById("saveDataValue").textContent = connection ? (connection.saveData ? t.active : t.inactive) : t.notAvailable;
    document.getElementById("onlineState").textContent = navigator.onLine ? t.online : t.offline;
    document.getElementById("protocolValue").textContent = location.protocol === "https:" ? "HTTPS" : "HTTP";
    document.getElementById("browserValue").textContent = detectBrowser();
    document.getElementById("screenValue").textContent = window.innerWidth + " × " + window.innerHeight;

    setMetricBadge("httpsBadge", location.protocol === "https:" ? "good" : "error", location.protocol === "https:" ? t.badgeSecure : t.badgeUnsecure);
    document.getElementById("httpsValue").textContent = location.protocol === "https:" ? t.badgeSecure : "HTTP";
}

function updateTestResults(results){
    const t = translations[currentLanguage] || translations.de;
    const success = results.filter(x => x.ok).length;
    const total = results.length;
    const failure = total ? Math.round(((total-success)/total)*100) : 100;

    setTest("testInternet", navigator.onLine, navigator.onLine ? t.online : t.offline, navigator.onLine ? t.online : t.offline);
    setTest("testHttp", success > 0, success + "/" + total + " OK", success + "/" + total);
    setTest("testHttps", location.protocol === "https:", location.protocol === "https:" ? t.badgeSecure : "HTTP", location.protocol === "https:" ? t.badgeSecure : "HTTP");
    setTest("testStability", failure === 0, failure === 0 ? t.badgeStable : failure + "%", failure === 0 ? t.badgeStable : "Check");
}

function setTest(prefix, good, detail, value){
    const icon = document.getElementById(prefix + "Icon");
    icon.className = "test-icon " + (good ? "good" : "error");
    icon.textContent = good ? "✓" : "!";
    document.getElementById(prefix + "Detail").textContent = detail;
    document.getElementById(prefix + "Value").textContent = value;
}

function setMetricBadge(id, type, text){
    const el = document.getElementById(id);
    if(!el) return;
    el.className = "badge " + type;
    el.textContent = text;
}

function resetBadges(){
    const t = translations[currentLanguage] || translations.de;
    ["latencyBadge","jitterBadge","failureBadge","httpBadge","httpsBadge","networkApiBadge"].forEach(id => setMetricBadge(id, "", t.badgeWaiting));
}

function setMainChecking(){
    const t = translations[currentLanguage] || translations.de;
    const pill = document.getElementById("mainStatusPill");
    pill.className = "status-pill warning";
    document.getElementById("mainStatusText").textContent = t.running;
    document.getElementById("bigStatus").className = "big-status warning";
    document.getElementById("bigStatus").textContent = "...";
    document.getElementById("checkTitle").textContent = t.checkTitleAnalyzing;
    document.getElementById("checkSubtitle").textContent = t.checkSubtitleAnalyzing;
}

function updateMainResult(result, history){
    const t = translations[currentLanguage] || translations.de;
    const pill = document.getElementById("mainStatusPill");
    const big = document.getElementById("bigStatus");

    if(result.ok){
        pill.className = "status-pill";
        document.getElementById("mainStatusText").textContent = t.statusReachable;
        big.className = "big-status";
        big.textContent = "✓";
        document.getElementById("checkTitle").textContent = t.checkTitleSuccess;
        document.getElementById("checkSubtitle").textContent = "HTTP " + result.status + " • " + result.ms + " ms";
    }else{
        pill.className = "status-pill error";
        document.getElementById("mainStatusText").textContent = t.statusFailed;
        big.className = "big-status error";
        big.textContent = "×";
        document.getElementById("checkTitle").textContent = t.checkTitleFail;
        document.getElementById("checkSubtitle").textContent = result.error || t.statusFailed;
    }

    document.getElementById("responseValue").textContent = result.ms + " ms";
    document.getElementById("lastChecked").textContent = new Date().toLocaleTimeString();
    document.getElementById("lastCheckedDate").textContent = new Date().toLocaleDateString();

    const total = history.length;
    const good = history.filter(x => x.success).length;
    document.getElementById("uptimeValue").textContent = total ? ((good/total)*100).toFixed(2) + "%" : "—";
    document.getElementById("checksValue").textContent = total;

    drawChart(history);
    updateIncident(history);
}

function updateIncident(history){
    const t = translations[currentLanguage] || translations.de;
    const failures = history.filter(x => !x.success).length;
    if(failures === 0){
        document.getElementById("incidentIcon").textContent = "✓";
        document.getElementById("incidentTitle").textContent = t.noIncidentsTitle;
        document.getElementById("incidentText").textContent = t.noIncidentsText;
    }else{
        document.getElementById("incidentIcon").textContent = "!";
        document.getElementById("incidentTitle").textContent = failures + " " + t.hasIncidentsTitle;
        document.getElementById("incidentText").textContent = t.hasIncidentsText;
    }
}

function drawChart(history){
    const t = translations[currentLanguage] || translations.de;
    const chart = document.getElementById("chart");
    const info = document.getElementById("chartInfo");
    chart.innerHTML = "";

    const measurements = history.filter(x => Number.isFinite(x.responseMs));
    if(!measurements.length){
        chart.innerHTML = '<div class="no-data">' + t.noData + '</div>';
        info.textContent = "0";
        return;
    }

    const max = Math.max(...measurements.map(x => x.responseMs), 1);
    measurements.forEach(item => {
        const bar = document.createElement("div");
        bar.className = "bar";
        bar.style.height = Math.max(5, (item.responseMs/max)*100) + "%";
        chart.appendChild(bar);
    });

    info.textContent = measurements.length;
}

function generateReport(){
    const d = latestDiagnostics;
    const lines = [
        "FASQOO STATUS REPORT",
        "Score: " + (d.score === null ? "N/A" : d.score + "/100"),
        "Latency: " + (d.latency === null ? "N/A" : d.latency + " ms"),
        "Jitter: " + (d.jitter === null ? "N/A" : d.jitter + " ms")
    ];
    document.getElementById("reportPreview").value = lines.join("\n");
}

document.getElementById("copyReportBtn").addEventListener("click", async function(){
    await navigator.clipboard.writeText(document.getElementById("reportPreview").value);
    this.textContent = "Kopiert";
    setTimeout(() => this.textContent = "Bericht kopieren", 1500);
});

document.getElementById("downloadReportBtn").addEventListener("click", function(){
    const blob = new Blob([document.getElementById("reportPreview").value], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "fasqoo-status.txt";
    a.click();
    URL.revokeObjectURL(url);
});

function detectBrowser(){
    const ua = navigator.userAgent;
    if(/Edg/i.test(ua)) return "Microsoft Edge";
    if(/Chrome/i.test(ua)) return "Google Chrome";
    if(/Firefox/i.test(ua)) return "Mozilla Firefox";
    if(/Safari/i.test(ua)) return "Apple Safari";
    return "Browser";
}

function sleep(ms){ return new Promise(resolve => setTimeout(resolve, ms)); }
function escapeHTML(value){ return String(value).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

// Initialisierung beim Laden
applyTheme();
applyLanguage(currentLanguage);
checkFasqoo();
runFullDiagnosis();

setInterval(checkFasqoo, CONFIG.CHECK_INTERVAL);
document.getElementById("checkBtn").addEventListener("click", runFullDiagnosis);
</script>

