{
  "manifest_version": 3,
  "name": "Meine Live-Data Extension",
  "version": "1.0",
  "permissions": [
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://deine-website.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
